generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FACULTY
  STUDENT
  HOD
  ADMIN
}

enum WorkMode {
  ONSITE
  REMOTE
}

enum AttendanceStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProjectStatus {
  PROPOSED
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  role       Role
  registerNo String?  @unique
  department String?
  isActive   Boolean  @default(true)
  teamId     String?
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  guideId    String?
  guide      User?    @relation("GuideStudents", fields: [guideId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  students            User[]         @relation("GuideStudents")
  projectsFaculty     Project[]      @relation("FacultyProjects")
  projectsProposed    Project[]      @relation("ProposedProjects")
  teamsLed            Team[]         @relation("TeamLeader")
  submissions         Submission[]
  attendances         Attendance[]   @relation("StudentAttendance")
  verifiedAttendances Attendance[]   @relation("VerifiedAttendance")
  internship          Internship?
  notifications       Notification[]

  @@index([role])
  @@index([department])
  @@index([guideId])
}

model Internship {
  id        String   @id @default(cuid())
  studentId String   @unique
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company   String
  position  String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  mode      WorkMode @default(REMOTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id                 String        @id @default(cuid())
  title              String
  description        String
  domain             String        @default("General")
  status             ProjectStatus @default(APPROVED)
  startDate          DateTime?     @db.Date
  deadline           DateTime?     @db.Date
  reviewRemark       String?
  facultyId          String
  faculty            User          @relation("FacultyProjects", fields: [facultyId], references: [id], onDelete: Cascade)
  proposedById       String?
  proposedBy         User?         @relation("ProposedProjects", fields: [proposedById], references: [id], onDelete: SetNull)
  progressPercentage Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  teams       Team[]
  submissions Submission[]

  @@index([facultyId])
  @@index([status])
}

model Team {
  id        String  @id @default(cuid())
  name      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leaderId  String?
  leader    User?   @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members   User[]
}

model Submission {
  id          String           @id @default(cuid())
  weekNumber  Int
  title       String
  description String
  link        String?
  status      SubmissionStatus @default(PENDING)
  feedback    String?
  reviewedAt  DateTime?
  studentId   String
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, weekNumber])
  @@index([projectId, status])
}

model Attendance {
  id           String           @id @default(cuid())
  studentId    String
  student      User             @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  mode         WorkMode
  summary      String
  status       AttendanceStatus @default(PENDING)
  remark       String?
  verifiedById String?
  verifiedBy   User?            @relation("VerifiedAttendance", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([date])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
